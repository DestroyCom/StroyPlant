# Production deployment env file (docker-compose.prod.yml's env_file) — copy to `.env` at the
# repo root on the production server and fill in real values. Distinct from backend/.env.example,
# which is for local dev (pnpm dev, no Docker).

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The real public URL this instance is reachable at (behind the reverse proxy)
BETTER_AUTH_URL=https://example.com

# Admin account creation — docker-entrypoint.sh creates it automatically on every boot if it
# doesn't already exist yet (idempotent, safe to leave set across restarts/redeploys).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MQTT + Home Assistant auto-discovery (Batch 7): no env var here — configured from the app's
# Settings page after first login, applied live with no restart needed.
