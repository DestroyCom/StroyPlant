# Production deployment env file (docker-compose.prod.yml's env_file) — copy to `.env` at the
# repo root on the production server and fill in real values. Distinct from backend/.env.example,
# which is for local dev (pnpm dev, no Docker).

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The real public URL this instance is reachable at (behind the reverse proxy)
BETTER_AUTH_URL=https://example.com

# Only used by `docker compose ... exec stroyplant pnpm seed:admin` (one-off admin account creation)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MQTT + Home Assistant auto-discovery (Batch 7) — leave empty to disable
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
