DATABASE_URL="file:./dev.db"

# mock | noble-bridge | node-ble
BLE_PROVIDER=mock

# Only used when BLE_PROVIDER=noble-bridge
NOBLE_BRIDGE_URL=http://localhost:4100

PORT=3000

# Auth (BetterAuth) — générer une vraie valeur avant tout déploiement réel :
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Utilisés uniquement par `pnpm seed:admin` (création ponctuelle du compte admin unique)
ADMIN_EMAIL=
ADMIN_PASSWORD=
