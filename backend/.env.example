DATABASE_URL="file:./dev.db"

# mock | noble-bridge | node-ble
BLE_PROVIDER=mock

# Only used when BLE_PROVIDER=noble-bridge
NOBLE_BRIDGE_URL=http://localhost:4100

PORT=3000

# Auth (BetterAuth) — generate a real value before any real deployment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Only used by `pnpm seed:admin` (one-off creation of the single admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Health Engine (Batch 4) — no env vars: baseline window / warm-up period are configured from the
# app's Settings page (HealthSettings DB row). See health.getSettings/upsertSettings (tRPC).

# MQTT + Home Assistant auto-discovery (Batch 7) — no env vars: configured from the app's Settings
# page (MqttSettings DB row), applied live with no restart needed. See mqtt.get/mqtt.upsert (tRPC).

# GlitchTip (self-hosted, Sentry-compatible) error monitoring. Optional — unset disables it on
# both backend and frontend (the frontend fetches this value live from GET /api/public-config).
SENTRY_DSN=
