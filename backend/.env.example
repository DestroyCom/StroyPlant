DATABASE_URL="file:./dev.db"

# mock | noble-bridge | node-ble
BLE_PROVIDER=mock

# Only used when BLE_PROVIDER=noble-bridge
NOBLE_BRIDGE_URL=http://localhost:4100

PORT=3000

# Auth (BetterAuth) — generate a real value before any real deployment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Only used by `pnpm seed:admin` (one-off creation of the single admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Health Engine (Batch 4) — per-device rolling baseline window (days) and minimum number of days
# before leaving "warm-up" mode (no alert until a device has enough history)
HEALTH_BASELINE_WINDOW_DAYS=14
HEALTH_WARMUP_MIN_DAYS=3
