generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DeviceKind {
  PARROT_POT
  XIAOMI_LYWSD03MMC
}

model Device {
  id         String     @id // MAC address, uppercase colon-separated — stable across providers
  kind       DeviceKind
  name       String?
  lastSeenAt DateTime?

  // Optional assignment (Batch 4, Health Engine) — never blocking, same logic as the Plant Dr
  // calibration (section 7.11): a device works perfectly fine with no profile assigned.
  plantProfileId Int?
  plantProfile   PlantProfile? @relation(fields: [plantProfileId], references: [id])

  readings       Reading[]
  wateringEvents WateringEvent[]
  schedule       Schedule?
}

// Auto-watering scheduler (Batch 5, docs/STROYPLANT_SPEC.md section 7.4) — one optional row per
// device. A missing row is not "no schedule", it's "defaults" (see
// backend/src/health/scheduler.ts's resolveEffectiveSchedule): `active` then falls back to
// `device.plantProfileId != null` (auto-on once a species is assigned, per DestCom's explicit
// choice), the other fields fall back to DEFAULT_SCHEDULE. This row only starts existing once the
// user explicitly saves the "Arrosage automatique" section on the device detail page.
model Schedule {
  deviceId String @id
  device   Device @relation(fields: [deviceId], references: [id])

  active           Boolean
  allowedStartHour Int // 0-23, local server time, inclusive
  allowedEndHour   Int // 0-23, local server time, exclusive — wraps past midnight if < allowedStartHour
  cooldownHours    Int // minimum delay since the last watering attempt (any source) before triggering again

  updatedAt DateTime @updatedAt
}

// Imported from assets/plants/watchflower_plantdb.csv (emericg/WatchFlower repo, GPLv3) — see
// backend/src/health/importSpeciesProfiles.ts. A MIN/MAX pair set to `null;null` means the
// parameter doesn't apply to this species in the source CSV (encoded `0;0`), not a real zero.
model PlantProfile {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  commonName String?

  soilMoistureMinPercent  Float?
  soilMoistureMaxPercent  Float?
  soilConductivityMinUsCm Float?
  soilConductivityMaxUsCm Float?
  soilPhMin               Float?
  soilPhMax               Float?
  temperatureMinC         Float?
  temperatureMaxC         Float?
  humidityMinPercent      Float?
  humidityMaxPercent      Float?
  lightMinLux             Float?
  lightMaxLux             Float?
  lightMinMmol            Float?
  lightMaxMmol            Float?

  devices Device[]
}

model Reading {
  id        Int      @id @default(autoincrement())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  timestamp DateTime @default(now())

  // Parrot Pot
  soilMoisturePercent      Float?
  temperatureC             Float?
  luminosity               Float?
  waterTankLevelPercent    Float?
  // Two raw candidates for soil conductivity (39e1fa0d/0e) — collected since 2026-07-28 to
  // empirically determine which one maps to the WatchFlower CSV's "Soil conductivity", see
  // docs/STROYPLANT_SPEC.md section 8. `soilConductivityEcPorous` is wired into the Health Engine
  // scoring (see docs/HEALTH_ENGINE.md); `soilConductivityEcb` stays diagnostic-only for now.
  soilConductivityEcb      Float?
  soilConductivityEcPorous Float?
  // Plant Dr STATUS_FLAGS (39e1FD86, Batch 6) — firmware-computed soil/reservoir/probe state, see
  // docs/STROYPLANT_SPEC.md section 7.11. `isInAir` readings are excluded from the Health Engine's
  // rolling-baseline calculations (section 7.3) — a probe out of the soil isn't a plant state.
  isDrySoil                Boolean?
  isWetSoil                Boolean?
  isEmptyTank              Boolean?
  isInAir                  Boolean?

  // Xiaomi LYWSD03MMC
  humidityPercent Float?
  batteryPercent  Float?

  @@index([deviceId, timestamp])
}

enum TriggerSource {
  MANUAL
  CRON
}

model WateringEvent {
  id            Int           @id @default(autoincrement())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id])
  timestamp     DateTime      @default(now())
  triggerSource TriggerSource
  success       Boolean
  errorDetail   String?

  @@index([deviceId, timestamp])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Batch 8 (docs/STROYPLANT_SPEC.md section 7.8) — OAuth 2.1 client/token/consent rows for the
  // MCP server, managed entirely by BetterAuth's `mcp` plugin (same schema as its `oidcProvider`
  // plugin).
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Batch 8 (docs/STROYPLANT_SPEC.md section 7.8) — BetterAuth's `mcp` plugin schema (identical to
// its `oidcProvider` plugin, which it wraps): OAuth 2.1 client registrations, issued access/refresh
// tokens, and recorded user consent, all owned by the plugin — StroyPlant's own code never reads or
// writes these tables directly.
model OauthApplication {
  id           String   @id
  name         String
  icon         String?
  metadata     String?
  clientId     String   @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  application           OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String           @id
  clientId     String
  application  OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}
