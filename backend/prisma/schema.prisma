generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DeviceKind {
  PARROT_POT
  XIAOMI_LYWSD03MMC
}

// Storage only for now (DestCom's explicit choice, 2026-07-29) — the Health Engine's scoring
// still compares every device against the same WatchFlower species ranges regardless of this
// value, even though those ranges are indoor-calibrated (real outdoor sun/temperature swings
// would make luminosity/temperature scoring meaningless outdoors). Wiring that distinction into
// scoring is deliberately deferred to a later batch, not guessed at here.
enum Environment {
  INDOOR
  OUTDOOR
}

model Device {
  id          String       @id // MAC address, uppercase colon-separated — stable across providers
  kind        DeviceKind
  name        String?
  lastSeenAt  DateTime?
  location    String? // free-text placement, e.g. "Salon", "Balcon" — user-entered, not validated
  environment Environment?

  // Optional assignment (Batch 4, Health Engine) — never blocking, same logic as the Plant Dr
  // calibration (section 7.11): a device works perfectly fine with no profile assigned.
  plantProfileId Int?
  plantProfile   PlantProfile? @relation(fields: [plantProfileId], references: [id])

  readings       Reading[]
  wateringEvents WateringEvent[]
  schedule       Schedule?
}

// Auto-watering scheduler (Batch 5, docs/STROYPLANT_SPEC.md section 7.4) — one optional row per
// device. A missing row is not "no schedule", it's "defaults" (see
// backend/src/health/scheduler.ts's resolveEffectiveSchedule): `active` then falls back to
// `device.plantProfileId != null` (auto-on once a species is assigned, per DestCom's explicit
// choice), the other fields fall back to DEFAULT_SCHEDULE. This row only starts existing once the
// user explicitly saves the "Arrosage automatique" section on the device detail page.
model Schedule {
  deviceId String @id
  device   Device @relation(fields: [deviceId], references: [id])

  active           Boolean
  allowedStartHour Int // 0-23, local server time, inclusive
  allowedEndHour   Int // 0-23, local server time, exclusive — wraps past midnight if < allowedStartHour
  cooldownHours    Int // minimum delay since the last watering attempt (any source) before triggering again

  updatedAt DateTime @updatedAt
}

// MQTT + Home Assistant auto-discovery (Batch 7) — instance-wide settings, editable from the
// Settings page instead of env vars (DestCom's explicit choice: a single source of truth, no env
// var fallback to keep in sync). Singleton row enforced at the application level (always
// read/upsert `where: {id: 1}`), not by the schema itself. `password` is stored in cleartext —
// consistent with how every other secret in this project is handled (e.g. BETTER_AUTH_SECRET in
// .env), no vault/encryption-at-rest for this single-admin, self-hosted deployment.
model MqttSettings {
  id              Int      @id @default(1)
  url             String?
  username        String?
  password        String?
  discoveryPrefix String   @default("homeassistant")
  baseTopic       String   @default("stroyplant")
  updatedAt       DateTime @updatedAt
}

// Health Engine (Batch 4, docs/STROYPLANT_SPEC.md section 7.3) — same singleton-row-editable-from-
// Settings pattern as MqttSettings above, moved off env vars for the same reason (DestCom's
// explicit choice: a single source of truth, no env var fallback to keep in sync).
model HealthSettings {
  id                 Int      @id @default(1)
  baselineWindowDays Int      @default(14)
  warmupMinDays      Int      @default(3)
  updatedAt          DateTime @updatedAt
}

// Imported from assets/plants/watchflower_plantdb.csv (emericg/WatchFlower repo, GPLv3) — see
// backend/src/health/importSpeciesProfiles.ts. A MIN/MAX pair set to `null;null` means the
// parameter doesn't apply to this species in the source CSV (encoded `0;0`), not a real zero.
model PlantProfile {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  commonName String?

  soilMoistureMinPercent  Float?
  soilMoistureMaxPercent  Float?
  soilConductivityMinUsCm Float?
  soilConductivityMaxUsCm Float?
  soilPhMin               Float?
  soilPhMax               Float?
  temperatureMinC         Float?
  temperatureMaxC         Float?
  humidityMinPercent      Float?
  humidityMaxPercent      Float?
  lightMinLux             Float?
  lightMaxLux             Float?
  lightMinMmol            Float?
  lightMaxMmol            Float?

  devices Device[]
}

enum ReadingSource {
  POLL // scanner's periodic poll, manual "sync now"/"forcer la synchro", MCP tool reads
  LIVE // live-mode session (backend/src/liveSession/manager.ts)
}

model Reading {
  id        Int      @id @default(autoincrement())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  timestamp DateTime @default(now())

  // Parrot Pot
  soilMoisturePercent      Float?
  temperatureC             Float?
  luminosity               Float?
  waterTankLevelPercent    Float?
  // Two raw candidates for soil conductivity (39e1fa0d/0e) — collected since 2026-07-28 to
  // empirically determine which one maps to the WatchFlower CSV's "Soil conductivity", see
  // docs/STROYPLANT_SPEC.md section 8. `soilConductivityEcPorous` is wired into the Health Engine
  // scoring (see docs/HEALTH_ENGINE.md); `soilConductivityEcb` stays diagnostic-only for now.
  soilConductivityEcb      Float?
  soilConductivityEcPorous Float?
  // Plant Dr STATUS_FLAGS (39e1FD86, Batch 6) — firmware-computed soil/reservoir/probe state, see
  // docs/STROYPLANT_SPEC.md section 7.11. `isInAir` readings are excluded from the Health Engine's
  // rolling-baseline calculations (section 7.3) — a probe out of the soil isn't a plant state.
  isDrySoil                Boolean?
  isWetSoil                Boolean?
  isEmptyTank              Boolean?
  isInAir                  Boolean?

  // Xiaomi LYWSD03MMC
  humidityPercent Float?
  batteryPercent  Float?

  // How this row was produced — POLL rows feed the Health Engine's rolling baseline and the
  // 24h/7d/30d history charts; LIVE rows (up to 300 in a 5min session) never do, so a live
  // session can never skew either (docs/superpowers/specs/2026-07-29-live-sensor-mode-design.md).
  source ReadingSource @default(POLL)

  @@index([deviceId, timestamp])
}

enum TriggerSource {
  MANUAL
  CRON
}

model WateringEvent {
  id            Int           @id @default(autoincrement())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id])
  timestamp     DateTime      @default(now())
  triggerSource TriggerSource
  success       Boolean
  errorDetail   String?

  @@index([deviceId, timestamp])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Batch 8 (docs/STROYPLANT_SPEC.md section 7.8) — OAuth 2.1 client/token/consent rows for the
  // MCP server, managed entirely by BetterAuth's `mcp` plugin (same schema as its `oidcProvider`
  // plugin).
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Batch 8 (docs/STROYPLANT_SPEC.md section 7.8) — BetterAuth's `mcp` plugin schema (identical to
// its `oidcProvider` plugin, which it wraps): OAuth 2.1 client registrations, issued access/refresh
// tokens, and recorded user consent, all owned by the plugin — StroyPlant's own code never reads or
// writes these tables directly.
model OauthApplication {
  id           String   @id
  name         String
  icon         String?
  metadata     String?
  clientId     String   @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  application           OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String           @id
  clientId     String
  application  OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}
